# Themenseite - stage, content with a side column, teaser row.
#
# The one arrangement of the four fixed colPos values that neither Startseite (no side
# column) nor Fachinhalt (no stage, no teaser row) can express. A topic page needs the
# stage to name the theme, the side column for contact details, and the teaser row to
# lead on into the subject pages below it.
mod.web_layout.BackendLayouts.landing {
    title = LLL:EXT:kern_ux/Resources/Private/Language/locallang_be.xlf:backendLayout.landing
    config.backend_layout {
        colCount = 2
        rowCount = 3
        rows {
            1.columns.1 {
                identifier = hero
                name = LLL:EXT:kern_ux/Resources/Private/Language/locallang_be.xlf:column.hero
                colPos = 1
                colspan = 2
            }
            2.columns {
                1 {
                    identifier = main
                    name = LLL:EXT:kern_ux/Resources/Private/Language/locallang_be.xlf:column.main
                    colPos = 0
                    colspan = 1
                }
                2 {
                    identifier = aside
                    name = LLL:EXT:kern_ux/Resources/Private/Language/locallang_be.xlf:column.aside
                    colPos = 2
                    colspan = 1
                }
            }
            3.columns.1 {
                identifier = teaser
                name = LLL:EXT:kern_ux/Resources/Private/Language/locallang_be.xlf:column.teaser
                colPos = 3
                colspan = 2
            }
        }
    }
}
