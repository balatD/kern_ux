<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" target-language="de" datatype="plaintext" original="messages" date="2026-09-24" product-name="kern_ux">
        <header/>
        <body>
            <trans-unit id="kern-ux-barriere-melden.element.page-1.properties.label">
                <source>Report a barrier</source>
                <target>Barriere melden</target>
            </trans-unit>
            <trans-unit id="kern-ux-barriere-melden.element.location.properties.label">
                <source>Where did you find the barrier?</source>
                <target>Wo ist Ihnen die Barriere begegnet?</target>
            </trans-unit>
            <trans-unit id="kern-ux-barriere-melden.element.location.properties.elementDescription">
                <source>The web address of the page, or its title if the address is not to hand.</source>
                <target>Die Adresse der Seite, oder ihr Titel, wenn die Adresse gerade nicht zur Hand ist.</target>
            </trans-unit>
            <trans-unit id="kern-ux-barriere-melden.element.barrier.properties.label">
                <source>What could you not do?</source>
                <target>Was konnten Sie nicht tun?</target>
            </trans-unit>
            <trans-unit id="kern-ux-barriere-melden.element.barrier.properties.elementDescription">
                <source>Describe it in your own words. Which part of the page, and what happened when you tried to use it.</source>
                <target>Beschreiben Sie es mit Ihren eigenen Worten: welcher Teil der Seite, und was passiert ist, als Sie ihn benutzen wollten.</target>
            </trans-unit>
            <trans-unit id="kern-ux-barriere-melden.element.reply-format.properties.label">
                <source>How should we reply?</source>
                <target>Wie sollen wir antworten?</target>
            </trans-unit>
            <trans-unit id="kern-ux-barriere-melden.element.reply-format.properties.elementDescription">
                <source>Pick the form you can read or hear most easily.</source>
                <target>Wählen Sie die Form, die Sie am leichtesten lesen oder hören können.</target>
            </trans-unit>
            <trans-unit id="kern-ux-barriere-melden.element.reply-format.properties.options.email">
                <source>By email</source>
                <target>Per E-Mail</target>
            </trans-unit>
            <trans-unit id="kern-ux-barriere-melden.element.reply-format.properties.options.phone">
                <source>By telephone</source>
                <target>Telefonisch</target>
            </trans-unit>
            <trans-unit id="kern-ux-barriere-melden.element.reply-format.properties.options.post">
                <source>By post</source>
                <target>Per Post</target>
            </trans-unit>
            <trans-unit id="kern-ux-barriere-melden.element.reply-format.properties.options.none">
                <source>No reply needed</source>
                <target>Keine Antwort nötig</target>
            </trans-unit>
            <trans-unit id="kern-ux-barriere-melden.element.name.properties.label">
                <source>Your name</source>
                <target>Ihr Name</target>
            </trans-unit>
            <trans-unit id="kern-ux-barriere-melden.element.email.properties.label">
                <source>Your email address</source>
                <target>Ihre E-Mail-Adresse</target>
            </trans-unit>
            <trans-unit id="kern-ux-barriere-melden.element.phone.properties.label">
                <source>Your telephone number</source>
                <target>Ihre Telefonnummer</target>
            </trans-unit>
            <trans-unit id="kern-ux-barriere-melden.element.privacy.properties.label">
                <source>I agree that my details may be used to answer this report.</source>
                <target>Ich bin damit einverstanden, dass meine Angaben zur Beantwortung dieser Meldung verwendet werden.</target>
            </trans-unit>
            <trans-unit id="kern-ux-kontakt.element.page-1.properties.label">
                <source>Contact</source>
                <target>Kontakt</target>
            </trans-unit>
            <trans-unit id="kern-ux-kontakt.element.name.properties.label">
                <source>Your name</source>
                <target>Ihr Name</target>
            </trans-unit>
            <trans-unit id="kern-ux-kontakt.element.email.properties.label">
                <source>Your email address</source>
                <target>Ihre E-Mail-Adresse</target>
            </trans-unit>
            <trans-unit id="kern-ux-kontakt.element.subject.properties.label">
                <source>Subject</source>
                <target>Betreff</target>
            </trans-unit>
            <trans-unit id="kern-ux-kontakt.element.message.properties.label">
                <source>Your message</source>
                <target>Ihre Nachricht</target>
            </trans-unit>
            <trans-unit id="kern-ux-kontakt.element.privacy.properties.label">
                <source>I agree that my details may be used to answer this enquiry.</source>
                <target>Ich bin damit einverstanden, dass meine Angaben zur Beantwortung dieser Anfrage verwendet werden.</target>
            </trans-unit>
        </body>
    </file>
