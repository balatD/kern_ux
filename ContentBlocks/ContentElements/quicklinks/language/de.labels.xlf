<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" target-language="de" datatype="plaintext" original="messages" date="2026-09-10" product-name="kern-ux/quicklinks">
        <header/>
        <body>
            <trans-unit id="title">
                <source>Quick access</source>
                <target>Schnellzugriff</target>
            </trans-unit>
            <trans-unit id="description">
                <source>A grid of icon-led tiles for the services people look for most.</source>
                <target>Ein Raster aus Kacheln mit Symbol für die am häufigsten gesuchten Leistungen.</target>
            </trans-unit>
            <trans-unit id="columns.label">
                <source>Columns</source>
                <target>Spalten</target>
            </trans-unit>
            <trans-unit id="columns.description">
                <source>Upper limit on a wide screen. A narrow screen always shows one tile per row.</source>
                <target>Obergrenze auf breiten Bildschirmen. Auf schmalen steht immer eine Kachel pro Zeile.</target>
            </trans-unit>
            <trans-unit id="tiles.label">
                <source>Tiles</source>
                <target>Kacheln</target>
            </trans-unit>
            <trans-unit id="tiles.title.label">
                <source>Title</source>
                <target>Titel</target>
            </trans-unit>
            <trans-unit id="tiles.link.label">
                <source>Target</source>
                <target>Ziel</target>
            </trans-unit>
            <trans-unit id="tiles.icon.label">
                <source>Icon</source>
                <target>Symbol</target>
            </trans-unit>
            <trans-unit id="tiles.icon.description">
                <source>Decorative: the title carries the meaning, so the icon is hidden from screen readers.</source>
                <target>Dekorativ: die Bedeutung trägt der Titel, deshalb bleibt das Symbol für Screenreader verborgen.</target>
            </trans-unit>
            <trans-unit id="tiles.text.label">
                <source>Text</source>
                <target>Text</target>
            </trans-unit>
        </body>
    </file>
