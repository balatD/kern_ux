<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" target-language="de" datatype="plaintext" original="messages" date="2026-09-10" product-name="kern-ux/service">
        <header/>
        <body>
            <trans-unit id="title">
                <source>Service</source>
                <target>Dienstleistung</target>
            </trans-unit>
            <trans-unit id="description">
                <source>An administrative service in the standard FIM field order: requirements, documents, fees, deadlines, legal basis.</source>
                <target>Eine Verwaltungsleistung in der FIM-Feldfolge: Voraussetzungen, Unterlagen, Gebühren, Fristen, Rechtsgrundlagen.</target>
            </trans-unit>
            <trans-unit id="teaser.label">
                <source>Short description</source>
                <target>Kurzbeschreibung</target>
            </trans-unit>
            <trans-unit id="teaser.description">
                <source>One or two sentences saying what the service is. Shown above the full text.</source>
                <target>Ein bis zwei Sätze dazu, worum es geht. Steht über dem Volltext.</target>
            </trans-unit>
            <trans-unit id="bodytext.label">
                <source>Full text</source>
                <target>Volltext</target>
            </trans-unit>
            <trans-unit id="onlineLabel.label">
                <source>Button label</source>
                <target>Beschriftung</target>
            </trans-unit>
            <trans-unit id="onlineLabel.description">
                <source>Leave empty to use the standard wording.</source>
                <target>Leer lassen übernimmt die Standardformulierung.</target>
            </trans-unit>
            <trans-unit id="onlineLink.label">
                <source>Online service</source>
                <target>Online-Dienst</target>
            </trans-unit>
            <trans-unit id="onlineLink.description">
                <source>The link that starts the service. Without it no button is rendered.</source>
                <target>Der Link, der die Leistung startet. Ohne ihn wird keine Schaltfläche ausgegeben.</target>
            </trans-unit>
            <trans-unit id="onlineHint.label">
                <source>Note on the online service</source>
                <target>Hinweis zum Online-Dienst</target>
            </trans-unit>
            <trans-unit id="onlineHint.description">
                <source>For example which account is required.</source>
                <target>Etwa, welches Konto dafür nötig ist.</target>
            </trans-unit>
            <trans-unit id="requirements.label">
                <source>Requirements</source>
                <target>Voraussetzungen</target>
            </trans-unit>
            <trans-unit id="requirements.text.label">
                <source>Requirement</source>
                <target>Voraussetzung</target>
            </trans-unit>
            <trans-unit id="documents.label">
                <source>Required documents</source>
                <target>Erforderliche Unterlagen</target>
            </trans-unit>
            <trans-unit id="documents.text.label">
                <source>Document</source>
                <target>Unterlage</target>
            </trans-unit>
            <trans-unit id="forms.label">
                <source>Forms</source>
                <target>Formulare</target>
            </trans-unit>
            <trans-unit id="forms.description">
                <source>Put the file format in the title, for example "Antragsformular (PDF)": a link has to be understandable from its text alone.</source>
                <target>Das Dateiformat gehört in den Titel, etwa "Antragsformular (PDF)" - ein Link muss aus sich heraus verständlich sein.</target>
            </trans-unit>
            <trans-unit id="forms.title.label">
                <source>Title</source>
                <target>Titel</target>
            </trans-unit>
            <trans-unit id="forms.link.label">
                <source>Target</source>
                <target>Ziel</target>
            </trans-unit>
            <trans-unit id="fees.label">
                <source>Fees</source>
                <target>Gebühren</target>
            </trans-unit>
            <trans-unit id="fees.description">
                <source>Rich text, so a fee schedule can be a table.</source>
                <target>Rich-Text, damit ein Gebührenverzeichnis als Tabelle stehen kann.</target>
            </trans-unit>
            <trans-unit id="deadlines.label">
                <source>Deadlines</source>
                <target>Fristen</target>
            </trans-unit>
            <trans-unit id="processingTime.label">
                <source>Average processing time</source>
                <target>Durchschnittliche Bearbeitungsdauer</target>
            </trans-unit>
            <trans-unit id="processingTime.description">
                <source>For example "sofort" or "2 bis 3 Wochen".</source>
                <target>Etwa "sofort" oder "2 bis 3 Wochen".</target>
            </trans-unit>
            <trans-unit id="legalBases.label">
                <source>Legal basis</source>
                <target>Rechtsgrundlagen</target>
            </trans-unit>
            <trans-unit id="legalBases.title.label">
                <source>Provision</source>
                <target>Vorschrift</target>
            </trans-unit>
            <trans-unit id="legalBases.link.label">
                <source>Target</source>
                <target>Ziel</target>
            </trans-unit>
            <trans-unit id="legalBases.link.description">
                <source>Optional.</source>
                <target>Optional.</target>
            </trans-unit>
            <trans-unit id="legalRemedy.label">
                <source>Legal remedy</source>
                <target>Rechtsbehelf</target>
            </trans-unit>
            <trans-unit id="furtherInformation.label">
                <source>Further information</source>
                <target>Weiterführende Informationen</target>
            </trans-unit>
            <trans-unit id="furtherInformation.title.label">
                <source>Title</source>
                <target>Titel</target>
            </trans-unit>
            <trans-unit id="furtherInformation.link.label">
                <source>Target</source>
                <target>Ziel</target>
            </trans-unit>
            <trans-unit id="responsibility.label">
                <source>Notes on responsibility</source>
                <target>Hinweise zur Zuständigkeit</target>
            </trans-unit>
            <trans-unit id="responsibility.description">
                <source>Which office handles this, when several could.</source>
                <target>Welche Stelle zuständig ist, wenn mehrere in Frage kommen.</target>
            </trans-unit>
        </body>
    </file>
</xliff>
